    <properties>
      <background color="-67073"/>
    </properties>
    <border type="line" title="Guardado" title-justification="2">
      <font name="Courier New" size="24" style="0"/>
      <title-color color="-12243167"/>
      <color color="-12243167"/>
    </border>
    <children>
